static void ble_uart_set_baud(uint32_t baud_rate) {
  HAL_UART_DeInit(&huart2);
  huart2.Init.BaudRate = baud_rate;
  if (HAL_UART_Init(&huart2) != HAL_OK) {
    Error_Handler();
  }
}

static void ble_uart_flush(void) {
  uint8_t byte = 0U;
  while (HAL_UART_Receive(&huart2, &byte, 1U, 5U) == HAL_OK) {
  }
}

static void ble_uart_send(const char *text) {
  HAL_UART_Transmit(&huart2, (uint8_t *)text, (uint16_t)strlen(text), 500U);
}

static bool ble_uart_wait_for(const char *token, uint32_t timeout_ms) {
  char buffer[96];
  uint32_t index = 0U;
  uint32_t started_at = HAL_GetTick();
  uint8_t byte = 0U;

  memset(buffer, 0, sizeof(buffer));
  while ((HAL_GetTick() - started_at) < timeout_ms) {
    if (HAL_UART_Receive(&huart2, &byte, 1U, 20U) == HAL_OK) {
      if (index < (sizeof(buffer) - 1U)) {
        buffer[index++] = (char)byte;
        buffer[index] = '\0';
      } else {
        memmove(buffer, buffer + 1, sizeof(buffer) - 2U);
        buffer[sizeof(buffer) - 2U] = (char)byte;
        buffer[sizeof(buffer) - 1U] = '\0';
      }

      if (strstr(buffer, token) != NULL) {
        return true;
      }
    }
  }

  return false;
}

static bool ble_module_enter_at_mode(void) {
  /* Respect datasheet timing: guard time before +++, then reply within 300ms. */
  ble_uart_flush();
  HAL_Delay(350U);
  ble_uart_send("+++");
  if (!ble_uart_wait_for("a", 800U)) {
    return false;
  }
  HAL_Delay(100U);
  ble_uart_send("a");
  return ble_uart_wait_for("+OK", 1000U);
}

static bool ble_module_send_at(const char *command, uint32_t timeout_ms) {
  ble_uart_send(command);
  return ble_uart_wait_for("OK", timeout_ms);
}

static bool ble_module_enter_at_mode_any_baud(uint32_t *matched_baud) {
  static const uint32_t baud_candidates[] = {57600U, 115200U, 38400U, 19200U, 9600U, 230400U};
  size_t i;

  for (i = 0U; i < (sizeof(baud_candidates) / sizeof(baud_candidates[0])); ++i) {
    ble_uart_set_baud(baud_candidates[i]);
    if (ble_module_enter_at_mode()) {
      if (matched_baud != NULL) {
        *matched_baud = baud_candidates[i];
      }
      return true;
    }
  }

  return false;
}

static void ble_module_force_uart_bridge_config(void) {
  bool entered_at = false;
  uint32_t matched_baud = 57600U;
  uint8_t attempt = 0U;

  HAL_Delay(600U);
  ble_uart_set_baud(115200U);

  for (attempt = 0U; attempt < 6U; ++attempt) {
    if (ble_module_enter_at_mode_any_baud(&matched_baud)) {
      entered_at = true;
      break;
    }
    HAL_Delay(250U);
  }

  if (!entered_at) {
    ble_uart_set_baud(57600U);
    return;
  }

  /* Datasheet configuration: slave + transparent transmission, 57600 8N1. */
  ble_module_send_at("AT+UART=57600,8,0,0\r\n", 1500U);
  HAL_Delay(120U);
  ble_module_send_at("AT+NAME=WH-BLE 106\r\n", 1500U);
  HAL_Delay(120U);
  ble_module_send_at("AT+MODE=S\r\n", 1500U);

  /* AT+MODE triggers automatic restart; re-enter AT afterwards per manual. */
  HAL_Delay(1800U);
  ble_uart_set_baud(57600U);
  ble_uart_flush();

  entered_at = false;
  for (attempt = 0U; attempt < 6U; ++attempt) {
    if (ble_module_enter_at_mode_any_baud(&matched_baud)) {
      entered_at = true;
      break;
    }
    HAL_Delay(250U);
  }

  if (!entered_at) {
    ble_uart_set_baud(57600U);
    return;
  }

  ble_module_send_at("AT+WMODE=0\r\n", 1500U);
  HAL_Delay(120U);
  ble_module_send_at("AT+ENTM\r\n", 1500U);
  HAL_Delay(200U);

  ble_uart_set_baud(57600U);
  ble_uart_flush();
}

#if MINIMAL_FIRMWARE
static void uart_write_line(const char *text) {
  HAL_UART_Transmit(&huart2, (uint8_t *)text, (uint16_t)strlen(text), 500U);
}

static size_t uart_read_line(char *buffer, size_t max_len) {
  static size_t index = 0U;
  uint8_t byte = 0U;

  if (HAL_UART_Receive(&huart2, &byte, 1U, 10U) != HAL_OK) {
    return 0U;
  }

  if (byte == '\r' || byte == '\n') {
    if (index == 0U) {
      return 0U;
    }
    buffer[index] = '\0';
    index = 0U;
    return strlen(buffer);
  }

  if (index < (max_len - 1U)) {
    buffer[index++] = (char)byte;
  }

  return 0U;
}

static void print_prompt(void) {
  uart_write_line("vp> ");
}

static void run_minimal_firmware(void) {
  GPIO_InitTypeDef gpio_init = {0};
  uint8_t led_state = 1U;
  uint32_t last_force_ms = 0U;
  char line[96];
  lis3mdl_vector3_t raw = {0};
  float heading = 0.0f;
  uint8_t whoami = 0U;

  gpio_init.Pin = LEFT_MOTOR_GPIO_PIN | RIGHT_MOTOR_GPIO_PIN;
  gpio_init.Mode = GPIO_MODE_OUTPUT_PP;
  gpio_init.Pull = GPIO_NOPULL;
  gpio_init.Speed = GPIO_SPEED_FREQ_LOW;
  HAL_GPIO_Init(LEFT_MOTOR_GPIO_PORT, &gpio_init);

  HAL_GPIO_WritePin(LEFT_MOTOR_GPIO_PORT, LEFT_MOTOR_GPIO_PIN, GPIO_PIN_SET);
  HAL_GPIO_WritePin(RIGHT_MOTOR_GPIO_PORT, RIGHT_MOTOR_GPIO_PIN, GPIO_PIN_SET);

  #if !BLE_SKIP_AT_CONFIG
  ble_module_force_uart_bridge_config();
  #endif
  compass_lis3mdl_init();

  uart_write_line("\r\nVeloPath minimal console\r\n");
  print_prompt();

  while (1) {
    if ((HAL_GetTick() - last_force_ms) >= 15000U) {
      last_force_ms = HAL_GetTick();
      /* Force BLE module into advertising/bridge mode via AT. */
      if (ble_module_enter_at_mode_any_baud(NULL)) {
        ble_module_send_at("AT+NAME=WH-BLE 106\r\n", 1500U);
        ble_module_send_at("AT+MODE=S\r\n", 1500U);
        ble_module_send_at("AT+UART=57600,8,0,0\r\n", 1500U);
        ble_module_send_at("AT+WMODE=0\r\n", 1500U);
        ble_module_send_at("AT+NOTIFY=ON\r\n", 1500U);
        ble_module_send_at("AT+ENTM\r\n", 1500U);
      }
    }

    if (uart_read_line(line, sizeof(line)) == 0U) {
      continue;
    }

    if (strcmp(line, "ping") == 0) {
      uart_write_line("pong\r\n");
    } else if (strcmp(line, "status") == 0) {
      uart_write_line("status: ok\r\n");
      if (compass_lis3mdl_read_who_am_i(&whoami)) {
        char buf[48];
        snprintf(buf, sizeof(buf), "compass whoami=0x%02X addr=0x%02X\r\n",
                 whoami, compass_lis3mdl_get_i2c_address());
        uart_write_line(buf);
      } else {
        uart_write_line("compass whoami=err\r\n");
      }
    } else if (strcmp(line, "autotest") == 0) {
      char buf[96];
      uint32_t odr = LEFT_MOTOR_GPIO_PORT->ODR;
      uint32_t idr = LEFT_MOTOR_GPIO_PORT->IDR;
      snprintf(buf, sizeof(buf), "gpio odr=0x%08lX idr=0x%08lX\r\n", odr, idr);
      uart_write_line(buf);
      if (compass_lis3mdl_read_who_am_i(&whoami)) {
        snprintf(buf, sizeof(buf), "compass whoami=0x%02X addr=0x%02X\r\n",
                 whoami, compass_lis3mdl_get_i2c_address());
        uart_write_line(buf);
      } else {
        uart_write_line("compass whoami=err\r\n");
      }
    } else if (strcmp(line, "compass") == 0) {
      if (compass_lis3mdl_read_raw(&raw)) {
        char buf[96];
        snprintf(buf, sizeof(buf), "raw x=%.0f y=%.0f z=%.0f\r\n", raw.x, raw.y, raw.z);
        uart_write_line(buf);
      } else {
        uart_write_line("raw err\r\n");
      }
      if (compass_lis3mdl_read_heading_degrees(&heading)) {
        char buf[64];
        snprintf(buf, sizeof(buf), "heading=%.2f\r\n", heading);
        uart_write_line(buf);
      } else {
        uart_write_line("heading err\r\n");
      }
    } else if (strcmp(line, "zero") == 0) {
      if (compass_lis3mdl_set_heading_zero_to_current()) {
        uart_write_line("zero ok\r\n");
      } else {
        uart_write_line("zero err\r\n");
      }
    } else if (strcmp(line, "led on") == 0) {
      led_state = 1U;
      HAL_GPIO_WritePin(LEFT_MOTOR_GPIO_PORT, LEFT_MOTOR_GPIO_PIN, GPIO_PIN_SET);
      HAL_GPIO_WritePin(RIGHT_MOTOR_GPIO_PORT, RIGHT_MOTOR_GPIO_PIN, GPIO_PIN_SET);
      uart_write_line("led on\r\n");
    } else if (strcmp(line, "led off") == 0) {
      led_state = 0U;
      HAL_GPIO_WritePin(LEFT_MOTOR_GPIO_PORT, LEFT_MOTOR_GPIO_PIN, GPIO_PIN_RESET);
      HAL_GPIO_WritePin(RIGHT_MOTOR_GPIO_PORT, RIGHT_MOTOR_GPIO_PIN, GPIO_PIN_RESET);
      uart_write_line("led off\r\n");
    } else if (strcmp(line, "help") == 0) {
      uart_write_line("cmd: ping, status, compass, zero, led on, led off, autotest, help\r\n");
    } else {
      uart_write_line("unknown\r\n");
    }

    print_prompt();
  }
}
#endif

#if PIN_TEST_MODE
static void set_left_indicator(uint8_t on) {
  HAL_GPIO_WritePin(LEFT_MOTOR_GPIO_PORT, LEFT_MOTOR_GPIO_PIN,
                    on ? LEFT_MOTOR_ACTIVE_STATE : LEFT_MOTOR_INACTIVE_STATE);
}

static void set_right_indicator(uint8_t on) {
  HAL_GPIO_WritePin(RIGHT_MOTOR_GPIO_PORT, RIGHT_MOTOR_GPIO_PIN,
                    on ? RIGHT_MOTOR_ACTIVE_STATE : RIGHT_MOTOR_INACTIVE_STATE);
}

static void set_both_indicators(uint8_t on) {
  set_left_indicator(on);
  set_right_indicator(on);
}

static void blink_left_indicator(uint8_t count, uint32_t on_ms, uint32_t off_ms) {
  uint8_t i;

  for (i = 0U; i < count; ++i) {
    set_left_indicator(1U);
    HAL_Delay(on_ms);
    set_left_indicator(0U);
    HAL_Delay(off_ms);
  }
}

static void blink_both_indicators(uint8_t count, uint32_t on_ms, uint32_t off_ms) {
  uint8_t i;

  for (i = 0U; i < count; ++i) {
    set_both_indicators(1U);
    HAL_Delay(on_ms);
    set_both_indicators(0U);
    HAL_Delay(off_ms);
  }
}

  static void run_pin_test_mode(void) {
    GPIO_InitTypeDef gpio_init = {0};

    gpio_init.Pin = LEFT_MOTOR_GPIO_PIN;
    gpio_init.Mode = GPIO_MODE_OUTPUT_PP;
    gpio_init.Pull = GPIO_NOPULL;
    gpio_init.Speed = GPIO_SPEED_FREQ_LOW;
    HAL_GPIO_Init(LEFT_MOTOR_GPIO_PORT, &gpio_init);

    if (RIGHT_MOTOR_GPIO_PORT != LEFT_MOTOR_GPIO_PORT) {
      gpio_init.Pin = RIGHT_MOTOR_GPIO_PIN;
      HAL_GPIO_Init(RIGHT_MOTOR_GPIO_PORT, &gpio_init);
    }

    while (1) {
      HAL_GPIO_TogglePin(LEFT_MOTOR_GPIO_PORT, LEFT_MOTOR_GPIO_PIN);
      HAL_GPIO_TogglePin(RIGHT_MOTOR_GPIO_PORT, RIGHT_MOTOR_GPIO_PIN);
      HAL_Delay(1000U);
    }
  }
#endif
#if BLE_UART_ECHO_TEST
static void run_ble_uart_echo_test(void) {
  static const uint32_t baud_candidates[] = {57600U, 115200U, 38400U, 19200U, 9600U, 230400U};
  static const char *labels[] = {"B57600 ", "B115200 ", "B38400 ", "B19200 ", "B9600 ", "B230400 "};
  uint8_t byte = 0U;
  size_t index = 0U;
  uint32_t started_at = 0U;
  GPIO_InitTypeDef gpio_init = {0};

  gpio_init.Pin = LEFT_MOTOR_GPIO_PIN | RIGHT_MOTOR_GPIO_PIN;
  gpio_init.Mode = GPIO_MODE_OUTPUT_PP;
  gpio_init.Pull = GPIO_NOPULL;
  gpio_init.Speed = GPIO_SPEED_FREQ_LOW;
  HAL_GPIO_Init(LEFT_MOTOR_GPIO_PORT, &gpio_init);
  HAL_GPIO_WritePin(LEFT_MOTOR_GPIO_PORT, LEFT_MOTOR_GPIO_PIN, LEFT_MOTOR_INACTIVE_STATE);
  HAL_GPIO_WritePin(RIGHT_MOTOR_GPIO_PORT, RIGHT_MOTOR_GPIO_PIN, RIGHT_MOTOR_INACTIVE_STATE);

  while (1) {
    ble_uart_set_baud(baud_candidates[index]);
    ble_uart_flush();
    HAL_GPIO_WritePin(LEFT_MOTOR_GPIO_PORT, LEFT_MOTOR_GPIO_PIN, LEFT_MOTOR_INACTIVE_STATE);
    HAL_GPIO_WritePin(RIGHT_MOTOR_GPIO_PORT, RIGHT_MOTOR_GPIO_PIN, RIGHT_MOTOR_INACTIVE_STATE);

    started_at = HAL_GetTick();
    while ((HAL_GetTick() - started_at) < 4000U) {
      if (HAL_UART_Receive(&huart2, &byte, 1U, 25U) == HAL_OK) {
        HAL_GPIO_WritePin(LEFT_MOTOR_GPIO_PORT, LEFT_MOTOR_GPIO_PIN, LEFT_MOTOR_ACTIVE_STATE);
        HAL_GPIO_WritePin(RIGHT_MOTOR_GPIO_PORT, RIGHT_MOTOR_GPIO_PIN, RIGHT_MOTOR_ACTIVE_STATE);
        HAL_UART_Transmit(&huart2, (uint8_t *)labels[index], (uint16_t)strlen(labels[index]), 500U);
        HAL_UART_Transmit(&huart2, &byte, 1U, 100U);
        HAL_GPIO_WritePin(LEFT_MOTOR_GPIO_PORT, LEFT_MOTOR_GPIO_PIN, LEFT_MOTOR_INACTIVE_STATE);
        HAL_GPIO_WritePin(RIGHT_MOTOR_GPIO_PORT, RIGHT_MOTOR_GPIO_PIN, RIGHT_MOTOR_INACTIVE_STATE);
      }
    }

    index = (index + 1U) % (sizeof(baud_candidates) / sizeof(baud_candidates[0]));
  }
}
#endif

#if !PIN_TEST_MODE
static void heartbeat_update(uint32_t now_ms) {
  static uint32_t last_ms = 0U;
  static uint8_t state = 0U;
  GPIO_InitTypeDef gpio_init = {0};

  if ((now_ms - last_ms) < 800U) {
    return;
  }
  last_ms = now_ms;
  state = !state;

  /* Force pins to push-pull output in case other code left them analog. */
  gpio_init.Pin = LEFT_MOTOR_GPIO_PIN | RIGHT_MOTOR_GPIO_PIN;
  gpio_init.Mode = GPIO_MODE_OUTPUT_PP;
  gpio_init.Pull = GPIO_NOPULL;
  gpio_init.Speed = GPIO_SPEED_FREQ_LOW;
  HAL_GPIO_Init(LEFT_MOTOR_GPIO_PORT, &gpio_init);

  HAL_GPIO_WritePin(LEFT_MOTOR_GPIO_PORT, LEFT_MOTOR_GPIO_PIN,
                    state ? GPIO_PIN_SET : GPIO_PIN_RESET);
  HAL_GPIO_WritePin(RIGHT_MOTOR_GPIO_PORT, RIGHT_MOTOR_GPIO_PIN,
                    state ? GPIO_PIN_SET : GPIO_PIN_RESET);
}
#endif
#if BLE_UART_TX_BEACON_TEST
static void run_ble_uart_tx_beacon_test(void) {
  char line[160];
  lis3mdl_vector3_t raw = {0};
  float heading_abs = 0.0f;
  float heading_rel = 0.0f;
  uint8_t who_am_i = 0U;
  int length = 0;
  GPIO_InitTypeDef gpio_init = {0};

  gpio_init.Pin = LEFT_MOTOR_GPIO_PIN | RIGHT_MOTOR_GPIO_PIN;
  gpio_init.Mode = GPIO_MODE_OUTPUT_PP;
  gpio_init.Pull = GPIO_NOPULL;
  gpio_init.Speed = GPIO_SPEED_FREQ_LOW;
  HAL_GPIO_Init(LEFT_MOTOR_GPIO_PORT, &gpio_init);
  HAL_GPIO_WritePin(LEFT_MOTOR_GPIO_PORT, LEFT_MOTOR_GPIO_PIN, LEFT_MOTOR_INACTIVE_STATE);
  HAL_GPIO_WritePin(RIGHT_MOTOR_GPIO_PORT, RIGHT_MOTOR_GPIO_PIN, RIGHT_MOTOR_INACTIVE_STATE);

  ble_uart_set_baud(57600U);
  ble_uart_flush();
  HAL_Delay(1200U);

  if (!compass_lis3mdl_read_who_am_i(&who_am_i)) {
    while (1) {
      length = snprintf(line, sizeof(line), "compass whoami read failed\r\n");
      HAL_UART_Transmit(&huart2, (uint8_t *)line, (uint16_t)length, 500U);
      HAL_GPIO_WritePin(LEFT_MOTOR_GPIO_PORT, LEFT_MOTOR_GPIO_PIN, LEFT_MOTOR_ACTIVE_STATE);
      HAL_Delay(80U);
      HAL_GPIO_WritePin(LEFT_MOTOR_GPIO_PORT, LEFT_MOTOR_GPIO_PIN, LEFT_MOTOR_INACTIVE_STATE);
      HAL_Delay(920U);
    }
  }

  if (!compass_lis3mdl_init()) {
    while (1) {
      length = snprintf(line, sizeof(line), "compass init failed whoami=0x%02X\r\n", who_am_i);
      HAL_UART_Transmit(&huart2, (uint8_t *)line, (uint16_t)length, 500U);
      HAL_GPIO_WritePin(LEFT_MOTOR_GPIO_PORT, LEFT_MOTOR_GPIO_PIN, LEFT_MOTOR_ACTIVE_STATE);
      HAL_Delay(80U);
      HAL_GPIO_WritePin(LEFT_MOTOR_GPIO_PORT, LEFT_MOTOR_GPIO_PIN, LEFT_MOTOR_INACTIVE_STATE);
      HAL_Delay(920U);
    }
  }

  while (1) {
    if (compass_lis3mdl_read_raw(&raw) &&
        compass_lis3mdl_read_heading_degrees(&heading_abs) &&
        compass_lis3mdl_read_relative_heading_degrees(&heading_rel)) {
      length = snprintf(line,
                        sizeof(line),
                        "compass raw x=%ld y=%ld z=%ld abs=%ld.%02ld rel=%ld.%02ld\r\n",
                        (long)lroundf(raw.x),
                        (long)lroundf(raw.y),
                        (long)lroundf(raw.z),
                        (long)heading_abs,
                        (long)lroundf(fabsf(heading_abs - (float)((long)heading_abs)) * 100.0f),
                        (long)heading_rel,
                        (long)lroundf(fabsf(heading_rel - (float)((long)heading_rel)) * 100.0f));
    } else {
      length = snprintf(line, sizeof(line), "compass read failed\r\n");
    }

    HAL_UART_Transmit(&huart2, (uint8_t *)line, (uint16_t)length, 500U);
    HAL_GPIO_WritePin(LEFT_MOTOR_GPIO_PORT, LEFT_MOTOR_GPIO_PIN, LEFT_MOTOR_ACTIVE_STATE);
    HAL_GPIO_WritePin(RIGHT_MOTOR_GPIO_PORT, RIGHT_MOTOR_GPIO_PIN, RIGHT_MOTOR_ACTIVE_STATE);
    HAL_Delay(80U);
    HAL_GPIO_WritePin(LEFT_MOTOR_GPIO_PORT, LEFT_MOTOR_GPIO_PIN, LEFT_MOTOR_INACTIVE_STATE);
    HAL_GPIO_WritePin(RIGHT_MOTOR_GPIO_PORT, RIGHT_MOTOR_GPIO_PIN, RIGHT_MOTOR_INACTIVE_STATE);
    HAL_Delay(420U);
  }
}
#endif
/* USER CODE END 0 */

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_I2C2_Init();
  MX_USART2_UART_Init();
  /* USER CODE BEGIN 2 */
  #if PIN_TEST_MODE
    run_pin_test_mode();
  #endif
  #if MINIMAL_FIRMWARE
    run_minimal_firmware();
  #endif
  #if BLE_UART_ECHO_TEST
    run_ble_uart_echo_test();
  #endif
#if BLE_UART_TX_BEACON_TEST
  run_ble_uart_tx_beacon_test();
#endif
  ble_module_force_uart_bridge_config();
  ble_link_init();
  motor_control_init();
  navigation_controller_init();
  compass_lis3mdl_init();
  console_diag_init();

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
    {
      /* USER CODE END WHILE */

      /* USER CODE BEGIN 3 */
      ble_link_poll_uart();

      if (ble_link_poll_line(ble_line, sizeof(ble_line))) {
        if (console_diag_try_handle(ble_line)) {
          /* handled by console */
        } else if (app_protocol_parse_line(ble_line, &nav_command)) {
        navigation_controller_handle_command(&nav_command);
      } else {
        console_diag_printf("unknown command: %s\r\n", ble_line);
        console_diag_print_prompt();
        }
        memset(ble_line, 0, sizeof(ble_line));
      }

      console_diag_update(HAL_GetTick());
    navigation_controller_update(HAL_GetTick());
    motor_control_update(HAL_GetTick());
#if !PIN_TEST_MODE
    heartbeat_update(HAL_GetTick());
#endif
  }
  /* USER CODE END 3 */
}

